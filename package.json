{
  "name": "data-craft-nexus",
  "version": "0.2.0",
  "private": true,
  "description": "Reads a dataset's six-axis signature and recommends models, drift checkers and pipelines.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --test \"tests/**/*.test.js\"",
    "build": "node scripts/build.mjs",
    "check:links": "node tools/check_links.mjs",
    "build:check": "node scripts/build.mjs --check",
    "serve": "python3 -m http.server 8000 -d site"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
